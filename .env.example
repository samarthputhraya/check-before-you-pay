GEMINI_API_KEY=
IDENTIFIER_SALT=
SQLITE_PATH=./data/app.db
PUBLIC_BASE_URL=
ADMIN_TOKEN=
VIASOCKET_REPORT_WEBHOOK_URL=
# Telegram: BotFather token and a separate 32+ character webhook secret. Never log Bot API URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Dodo Payments, backend only (see docs/DODO.md). Checkout stays off until the key, the webhook secret and a
# plan's product ID are all set. DODO_MODE is test_mode unless it is exactly live_mode.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=test_mode
DODO_PRODUCT_FAMILY=
DODO_PRODUCT_API=
# Shown only while Dodo can't be reached; otherwise /api/plans shows each product's price from Dodo.
DODO_PRICE_FAMILY_INR=49
DODO_PRICE_API_INR=999
WISPR_API_KEY=
OPENAI_API_KEY=
# List accessible models with: python -m backend.model_inventory
# Selected names are checked against the provider's model listing at startup.
GEMINI_EXTRACT_MODEL=
GEMINI_EXPLAIN_MODEL=
GEMINI_EMBED_MODEL=
GEMINI_TTS_MODEL=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_TRANSCRIBE_MODEL=
IP_CHECKS_PER_HOUR=3000
# Enable only on Railway HTTP-edge ingress, without TCP proxy or untrusted private ingress.
# PUBLIC_BASE_URL must be the deployed HTTPS origin. X-Forwarded-For is never used.
TRUST_RAILWAY_EDGE=false
# On the GCE VM behind Caddy: use Caddy's X-Forwarded-For (only from a private peer) for per-IP limits.
TRUST_PROXY=
# Local PhishTank verified-online JSON snapshot, max age 24 hours. See seed/README.md.
PHISHTANK_FEED_PATH=
